# =====================================================================
# SECURITY & SENSITIVE CREDENTIALS (NEVER COMMIT TO GITHUB)
# =====================================================================
.env
.env.*
*.env
*.env.*
*.local
!*.example
!*.sample

# API Keys, Tokens & Private Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
*.pub
*token*.json
*token*.txt
*credential*.json
*secret*.json
secrets/
credentials/

# =====================================================================
# PYTHON & ENVIRONMENT
# =====================================================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# =====================================================================
# LOCAL DATA, STORAGE & RUNTIME ARTIFACTS
# =====================================================================
